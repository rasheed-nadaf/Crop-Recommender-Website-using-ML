<!-- views/index.ejs -->
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Crop Recommendation</title>
    <link rel="stylesheet" href="/css/styles.css"/>
</head>

<body>
    <header>
        <nav>
            <ul>
                <li><a href="/">Home</a></li>
            </ul>
        </nav>
    </header>
    <div class="container">
        
        <form action="/submit" method="POST">
            <h1>Enter Soil and Environment Parameters</h1>
            <label for="nitrogen">Nitrogen:</label>
            <input type="number" step="0.01" id="nitrogen" name="nitrogen" max="250" required><br><br>

            <label for="phosphorus">Phosphorus:</label>
            <input type="number" step="0.01" id="phosphorus" name="phosphorus" max="250" required><br><br>

            <label for="potassium">Potassium:</label>
            <input type="number" step="0.01" id="potassium" name="potassium" max="250" required><br><br>

            <label for="temperature">Temperature:</label>
            <input type="number" step="0.01" id="temperature" name="temperature" max="50" required><br><br>

            <label for="humidity">Humidity(%):</label>
            <input type="number" step="0.01" id="humidity" name="humidity" max="120" required><br><br>

            <label for="pH">pH Value:</label>
            <input type="number" step="0.01" id="pH" name="pH" min="0" max="14" required><br><br>

            <label for="rainfall">Rainfall(mm):</label>
            <input type="number" step="0.01" id="rainfall" name="rainfall" max="400" required><br><br>

            <button type="submit">Submit</button>
        </form>
    </div>
    <footer>
        <p>Copyright@rasheed</p>
    </footer>
</body>

</html>